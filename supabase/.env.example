# Supabase Edge Function secrets — server-side only, NEVER in either app.
# Local:  cp supabase/.env.example supabase/.env  (npx supabase functions serve --env-file supabase/.env)
# Hosted: npx supabase secrets set --env-file supabase/.env
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.

# Google Places API (New) and Routes API. Restrict both keys to those APIs (no app restriction:
# they are only ever called from Supabase's servers).
GOOGLE_ROUTES_API_KEY=
GOOGLE_PLACES_API_KEY=

# Payments: only "mock" exists until the mobile-money aggregator is chosen.
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_SECRET=change-me-local-webhook-secret

# Safety SMS to trusted contacts: only "mock" exists (logs instead of sending).
SMS_PROVIDER=mock
SMS_PROVIDER_SECRET=

# Public page that renders a shared trip (calls /shared-trip?token=...). Leave empty to omit the link.
TRIP_SHARE_BASE_URL=

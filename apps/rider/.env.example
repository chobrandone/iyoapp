EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Maps SDK only. Restrict this key to the com.iyodriver.rider bundle ID / package + signing cert.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_APP_ROLE=rider
# Optional: per-platform Maps SDK keys (a Google key can be restricted to iOS *or* Android apps).
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
